{
  "manifest_version": 3,
  "name": "Swallow Picker",
  "version": "1.0.0",
  "description": "Random and controlled-random episode picker for swallow.",
  "key": "",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["scripting"],
  "host_permissions": ["https://swallow-mocha.vercel.app/*", "http://127.0.0.1:5173/*"]
}
