# Copy to backend/.env and adjust.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/swallow
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clerk owns identity: sign-up, sign-in, email verification and OAuth (GitHub and
# whatever else is enabled in the dashboard). The API only verifies session tokens.
# Without a secret key every request is treated as anonymous, on purpose.
CLERK_SECRET_KEY=
# Origins allowed to mint tokens for this API, checked against the token's `azp`.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
