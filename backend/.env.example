# Copy to backend/.env and adjust.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/swallow
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# Signup verification email. With SMTP_HOST empty the code is logged instead of
# sent, which is what you want locally and never what you want in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=Swallow <no-reply@swallow.local>
